{
  "name": "backend-engineering-assessment",
  "version": "1.0.0",
  "description": "Backend Engineering Assessment Node.js & TypeScript Project",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "generate": "npx prisma generate",
    "migrate:shards": "ts-node scripts/migrate.ts",
    "generate:csv": "ts-node scripts/generate-csv.ts",
    "test": "ts-node tests/run-tests.ts",
    "test:gcs": "ts-node scripts/test-gcs.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.3.9",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
