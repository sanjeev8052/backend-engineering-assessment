datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  order_id     String   @id
  customer_id  String
  order_date   DateTime
  order_amount Decimal  @db.Decimal(12, 2)
  status       String
  created_at   DateTime @default(now())

  @@index([customer_id])
  @@map("orders")
}